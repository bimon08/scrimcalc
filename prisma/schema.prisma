// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String?
  image           String?
  role            String    @default("USER")       // "ADMIN" or "USER"
  subscriptionEnd DateTime? @map("subscription_end") // null = no active subscription
  pendingPlanDays Int?       @map("pending_plan_days") // admin-assigned plan waiting for user to activate
  isTrial         Boolean   @default(true) @map("is_trial") // true = free trial, false = paid plan
  rules           String[]  @default([])
  sharedCodes     String[]  @default([]) @map("shared_codes")
  createdAt       DateTime  @default(now()) @map("created_at")
  wallets         Wallet[]
  savedTournaments SavedTournament[]

  @@map("users")
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  playerName   String        @map("player_name")
  shareToken   String        @unique @default(uuid()) @map("share_token")
  phone        String?
  balance      Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]
  bookings     SlotBooking[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id        String   @id @default(uuid())
  walletId  String   @map("wallet_id")
  amount    Int
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model SavedTournament {
  id          String        @id
  userId      String        @map("user_id")
  data        Json
  shareToken  String?       @unique @map("share_token")
  shortCode   String?       @unique @map("short_code")
  editToken   String?       @unique @map("edit_token")
  entryFee    Int           @default(0) @map("entry_fee")
  isActive    Boolean       @default(false) @map("is_active")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  bookings    SlotBooking[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_tournaments")
}

model SlotBooking {
  id            String          @id @default(uuid())
  walletId      String          @map("wallet_id")
  tournamentId  String          @map("tournament_id")
  entryFee      Int             @map("entry_fee")
  status        String          @default("PENDING")
  bookedByAdmin Boolean         @default(false) @map("booked_by_admin")
  roster        Json?
  createdAt     DateTime        @default(now()) @map("created_at")
  confirmedAt   DateTime?       @map("confirmed_at")
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tournament    SavedTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([walletId, tournamentId])
  @@map("slot_bookings")
}

model TournamentPage {
  id              String    @id @default(uuid())
  slug            String    @unique                    // URL slug e.g. "cherry-blossom-cup"
  name            String                               // Display name e.g. "Cherry Blossom Festival Cup"
  subtitle        String?                              // e.g. "by Jubilant Divine Esports"
  description     String?                              // About section text
  bannerUrl       String?   @map("banner_url")         // Banner image URL
  backgroundUrl   String?   @map("background_url")     // Background image URL
  themeColor      String    @default("#ec4899") @map("theme_color") // Primary theme color (hex)
  particleStyle   String    @default("petals") @map("particle_style") // "petals" | "snow" | "sparks" | "none"
  prizePool       String?   @map("prize_pool")         // e.g. "₹10,000"
  entryFee        String?   @map("entry_fee_display")  // Display string e.g. "₹400"
  entryFeeAmount  Int       @default(0) @map("entry_fee_amount") // Numeric fee for validation
  region          String?                              // e.g. "Northeast"
  deadline        String?                              // e.g. "21 Oct"
  bonusText       String?   @map("bonus_text")         // e.g. "+ 4 Cherry Blossom Festival Passes..."
  gameMode        String?   @map("game_mode")          // e.g. "BGMI · Squad"
  dateRange       String?   @map("date_range")         // e.g. "24 Oct — 7 Nov"
  eligibility     String?                              // e.g. "NE States Only"
  stateList       String[]  @default([]) @map("state_list")  // State options for dropdown
  upiId           String?   @map("upi_id")             // Payment UPI ID
  qrImageUrl      String?   @map("qr_image_url")       // Payment QR image
  termsEligibility String?  @map("terms_eligibility")  // Terms text
  termsDates      String?   @map("terms_dates")
  termsExtra      String?   @map("terms_extra")
  footerText      String?   @map("footer_text")        // Footer line
  fieldConfig     Json?     @map("field_config")       // Per-field visibility: { fieldKey: "required"|"optional"|"hidden" }
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  registrations   TournamentRegistration[]

  @@map("tournament_pages")
}

model TournamentRegistration {
  id            String         @id @default(uuid())
  tournamentId  String         @map("tournament_id")
  state         String?
  teamName      String         @map("team_name")
  teamLogoUrl   String?        @map("team_logo_url")
  iglName       String         @map("igl_name")
  iglId         String?        @map("igl_id")
  whatsapp      String?
  email         String?
  player2Ign    String?        @map("player2_ign")
  player2Id     String?        @map("player2_id")
  player3Ign    String?        @map("player3_ign")
  player3Id     String?        @map("player3_id")
  player4Ign    String?        @map("player4_ign")
  player4Id     String?        @map("player4_id")
  utrNumber     String?        @map("utr_number")
  paymentProofUrl String?      @map("payment_proof_url")
  status        String         @default("PENDING")       // PENDING | VERIFIED | REJECTED
  createdAt     DateTime       @default(now()) @map("created_at")
  tournament    TournamentPage @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_registrations")
}

model ApiUsage {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  userEmail     String   @map("user_email")
  model         String                          // e.g. "gemini-3.8-flash"
  imageCount    Int      @map("image_count")
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  durationMs    Int      @default(0) @map("duration_ms")
  status        String   @default("success")    // "success" | "error"
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("api_usage")
}
